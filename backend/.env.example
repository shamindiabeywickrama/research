# Copy this file to .env and fill in values as needed

# Data Mode:
#   demo          = ML occupancy (no live Wi-Fi)
#   wifi          = live Wi-Fi occupancy + ML forecast
#   weather       = ML occupancy + live weather-aware forecast
#   wifi_weather  = live Wi-Fi occupancy + ML forecast + live weather (presentation mode)
DATA_MODE=demo

# Library configuration
LIBRARY_CAPACITY=200
LIBRARY_OPEN_HOUR=8
LIBRARY_CLOSE_HOUR=19

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Supabase for prediction history logging
# Find these in your Supabase project: Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# Wi-Fi Simulation Configuration
# Set to true to enable local network device detection
WIFI_SIMULATION_ENABLED=false

# Your laptop's IP address on the hotspot network
WIFI_INTERFACE_IP=172.20.10.5

# The hotspot gateway IP address
WIFI_GATEWAY=172.20.10.1

# The subnet to scan (CIDR notation)
WIFI_SUBNET=172.20.10.0/28

# Scan interval in seconds
WIFI_SCAN_INTERVAL=3

# Comma-separated IPs to exclude from device count (gateway + your laptop)
WIFI_EXCLUDE_IPS=172.20.10.1,172.20.10.5

# Optional baseline occupancy to add to detected devices
WIFI_OCCUPANCY_BASELINE=0

# ---------------------------------------------------------------------------
# Weather (Open-Meteo — no API key required for basic forecast data)
# Set WEATHER_LATITUDE / WEATHER_LONGITUDE to the university/library location.
# Do not use the student's current GPS location automatically.
# ---------------------------------------------------------------------------
WEATHER_ENABLED=true
WEATHER_PROVIDER=open_meteo

# Example: Colombo, Sri Lanka — replace with your campus coordinates
WEATHER_LATITUDE=6.9271
WEATHER_LONGITUDE=79.8612
WEATHER_TIMEZONE=auto

# Cache/update interval in seconds (900 = 15 minutes)
WEATHER_UPDATE_INTERVAL=900

# Prototype weather adjustment assumptions (not scientifically validated)
# Applied only because the trained model does not include weather features.
WEATHER_IMPACT_ENABLED=true
WEATHER_CLEAR_IMPACT=0.00
WEATHER_PARTLY_CLOUDY_IMPACT=0.00
WEATHER_CLOUDY_IMPACT=0.00
WEATHER_RAIN_IMPACT=0.10
WEATHER_HEAVY_RAIN_IMPACT=0.15
WEATHER_THUNDERSTORM_IMPACT=0.12
