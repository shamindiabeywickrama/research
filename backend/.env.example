# Copy this file to .env and fill in values as needed

# Data Mode: demo = ML predictions with demo data, wifi = local Wi-Fi simulation
DATA_MODE=demo

# Library configuration
LIBRARY_CAPACITY=200
LIBRARY_OPEN_HOUR=8
LIBRARY_CLOSE_HOUR=19

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Supabase for prediction history logging
# Find these in your Supabase project: Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# Wi-Fi Simulation Configuration
# Set to true to enable local network device detection
WIFI_SIMULATION_ENABLED=false

# Your laptop's IP address on the hotspot network
WIFI_INTERFACE_IP=172.20.10.5

# The hotspot gateway IP address
WIFI_GATEWAY=172.20.10.1

# The subnet to scan (CIDR notation)
WIFI_SUBNET=172.20.10.0/28

# Scan interval in seconds
WIFI_SCAN_INTERVAL=3

# Comma-separated IPs to exclude from device count (gateway + your laptop)
WIFI_EXCLUDE_IPS=172.20.10.1,172.20.10.5

# Optional baseline occupancy to add to detected devices
WIFI_OCCUPANCY_BASELINE=0
